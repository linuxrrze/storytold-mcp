# Only for build (committed template -- copy to .env locally; CI keeps the
# pins in sync). Space-separated apt pins, one per storytold app.
STORYTOLD_PINS="anicraft=0.2.1-1 art-craft=0.41.1 cadcraft=0.20.1-1 deckcraft=0.18.1-1 designcraft=0.20.1-1 effectcraft=0.24.1-1 figcraft=0.18.1-1 filmcraft=0.20.1-1 gridcraft=0.19.1-1 lightcraft=0.21.1-1 materialcraft=0.4.1-1 pdfcraft=0.21.1-1 photocraft=0.23.1-1 soundcraft=0.20.1-1 texturecraft=0.6.1-1 vectorcraft=0.24.1-1 wordcraft=0.18.1-1"

# Runtime, shared by both services of the hub compose (storytold-mcp +
# solidcraft-mcp). Keep these in line with codingenv's .env:
# Your host home -- same value as HOST_HOME for codingenv. $HOST_HOME/work
# is the shared work dir, seen at /home/sandbox/work in all three containers.
HOST_HOME=/home/YOURUSER
# uid/gid the MCP servers run as -- codingenv's PUID/PGID, so files they
# write into the work dir belong to you.
PUID=1000
PGID=1000
# codingenv's compose network (<its project dir name>_default).
CODINGENV_NETWORK=codingenv_default
# mcp-gateway log level (DEBUG shows every HTTP request)
MCP_LOG_LEVEL=INFO
# mcp-gateway only accepts requests whose Host header is the service name
# (storytold-mcp / solidcraft-mcp) or loopback. Reaching the servers under
# any other name or IP? List it here, space-separated (host = any port,
# or host:port).
MCP_ALLOWED_HOSTS=
# Every MCP session (one per client and app) gets its own server process.
# Seconds a session may idle -- no request running and the client's event
# stream closed -- before its process (and any unsaved document) is
# stopped; 0 = never.
MCP_IDLE_TIMEOUT=1800
# Running server processes per app; more sessions get HTTP 503. 0 = no limit.
MCP_MAX_SESSIONS=16
# 1 = answer initialize and the tool/prompt/resource lists from the
# discovery cache baked into the image and start a session's process only
# on its first real request (tool call, ...); 0 = start it at initialize.
MCP_LAZY=1
# Seconds a session that never started a process (it costs nothing) is kept
# without any request; 0 = forever.
MCP_LAZY_IDLE_TIMEOUT=86400
# Seconds between log lines with the number of active MCP connections,
# running server processes and their memory (PSS) / CPU (total and per
# app); 0 = off.
MCP_STATS_INTERVAL=60

# Global
TZ=Europe/Berlin
