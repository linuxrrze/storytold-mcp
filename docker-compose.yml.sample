# Craft MCP servers next to codingenv: storytold-mcp (all ArtCraft apps) and
# solidcraft-mcp, each serving its stdio MCP servers over HTTP (one server
# process per MCP session, started on demand) at
#   http://storytold-mcp:8080/servers/<app>/mcp
#   http://solidcraft-mcp:8080/servers/solidcraft/mcp
# Both join codingenv's network, so start codingenv first, then:
#   cp docker-compose.yml.sample docker-compose.yml
#   cp .env.sample .env        # set HOST_HOME, PUID/PGID, CODINGENV_NETWORK
#   docker compose up -d
# Client config for claude/opencode in codingenv:
#   docker compose exec storytold-mcp mcp-servers client-config claude
#
# No ports are published: mcp-gateway runs without authentication here, so
# the servers are only reachable from containers on codingenv's network.

x-mcp: &mcp
  restart: unless-stopped
  # .env must exist locally: cp .env.sample .env
  env_file: .env
  # codingenv's PUID/PGID: files written into the work dir belong to you.
  user: "${PUID:-1000}:${PGID:-1000}"
  volumes:
    - /etc/localtime:/etc/localtime:ro
    # The shared work dir, at the SAME path as inside codingenv (whose
    # Option A mounts HOST_HOME at /home/sandbox): a path the agent passes
    # to a tool means the same file in every container. All servers are
    # confined to it (see docker/files/app-args.conf). With codingenv's
    # Option B, mount the same host dir at /home/sandbox/work there too.
    - ${HOST_HOME:-/home/YOURUSER}/work:/home/sandbox/work
  # Scratch (headless renders, the rendered server config), RAM-backed and
  # wiped on every start, shared by all sessions -- the size is a limit, RAM
  # is only used for what is actually stored. App settings/autosaves live in
  # HOME=/home/mcp in the container layer: they survive restarts, not a
  # re-create -- anything worth keeping belongs in the work dir.
  tmpfs:
    - /tmp:size=10g
  networks:
    - codingenv
  # Uncomment to test from the host (e.g. MCP Inspector) -- localhost only.
  # ports:
  #   - "127.0.0.1:8081:8080"

services:
  storytold-mcp:
    <<: *mcp
    image: ghcr.io/linuxrrze/storytold-mcp:latest
    container_name: storytold-mcp
    # Engines start per MCP session, on its first tool call (connecting and
    # listing tools is answered from a cache): a client (claude/opencode)
    # with all apps configured only runs the apps it actually uses, ~5-20 MB
    # each idle. Cap them with MCP_MAX_SESSIONS (per app) in .env.

  solidcraft-mcp:
    <<: *mcp
    image: ghcr.io/linuxrrze/solidcraft-mcp:latest
    container_name: solidcraft-mcp

networks:
  codingenv:
    external: true
    name: ${CODINGENV_NETWORK:-codingenv_default}
